# Dependencies & build output
/node_modules/
/dist/
/.tmp-tests/

# Environment variables & secrets (keep .env.example)
.env
.env.*
!.env.example
*service-account*.json
*firebase-adminsdk*.json
*.pem
*.key

# Local databases, WAL/SHM & user data (root /data/ only — NEVER ignore src/data/)
/data/
!src/data/
!src/data/**
!src/data/brands.js
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs, backups & OS artifacts
*.log
npm-debug.log*
/backups/
.DS_Store
Thumbs.db
