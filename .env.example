# KeyVEX Environment Configuration Template (.env.example)
# Copy to .env for local development or configure in Netlify / Render environment variables.
# NEVER commit .env or private service-account / Redis secrets to version control.

# --- Frontend Public Firebase & Google OAuth Identifiers ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Optional: Local Firebase Emulators ---
VITE_FIREBASE_AUTH_EMULATOR_HOST=
VITE_FIRESTORE_EMULATOR_HOST=

# --- Optional: Single-Instance Node Server / Distributed Rate Limiting ---
NODE_ENV=production
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=/data/keyvex.db
TRUST_PROXY=1
ALLOWED_ORIGIN=
MULTI_INSTANCE=false
REDIS_REST_URL=
REDIS_REST_TOKEN=
